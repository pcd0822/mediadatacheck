rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ====== 헬퍼 ======
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // users/{uid}.role 을 읽어 교사 여부 판단.
    // get()은 규칙 엔진 내에서 다른 문서를 직접 조회하므로
    // users 문서의 read 규칙(자기만)에 막히지 않는다.
    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // 모둠(group) 협업 작업실 권한 헬퍼.
    // members 서브문서 존재로 멤버십을 판정 → group 문서 자체 변경 없이 합류/탈퇴 가능.
    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function isGroupLeader(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderUid == request.auth.uid;
    }

    // ====== config/teacher : 교사 인증 코드 게이트 (프로젝트 단위 단일 문서) ======
    // "교사당 Firebase 1개" 모델. salt+해시만 저장(평문 아님).
    match /config/{docId} {
      allow read: if isSignedIn();                  // 코드 검증 위해 로그인 사용자 읽기
      // 최초 설정: 문서가 없을 때(=create) 로그인 사용자가 본인 uid로 1회 생성
      allow create: if isSignedIn()
                    && request.resource.data.setByUid == request.auth.uid;
      allow update: if isTeacher();                 // 변경은 인증된 교사만
      allow delete: if false;
    }

    // ====== users/{uid} : 본인 프로필 ======
    match /users/{uid} {
      allow read: if isSelf(uid);

      // 최초 생성: 본인 UID, role은 student/teacher 중 하나만 허용
      allow create: if isSelf(uid)
                    && request.resource.data.role in ["student", "teacher"];

      // 갱신: 본인만, role은 변경 불가(최초 1회 확정)
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role;

      // 삭제 금지
      allow delete: if false;

      // 학생 체크리스트
      match /checklists/{checklistId} {
        allow read, write: if isSelf(uid);
      }

      // VAPM 알고리즘 모델 + 하위 training_data
      match /algorithm_model/{docId} {
        allow read, write: if isSelf(uid);

        match /training_data/{dataId} {
          allow read, write: if isSelf(uid);
        }
      }

      // 메타인지 피드백 카드
      match /feedback_cards/{cardId} {
        allow read, write: if isSelf(uid);
      }

      // 팩트체크 이력
      match /factcheck_history/{historyId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ====== media_items/{mediaId} : 교사가 등록한 미디어 ======
    match /media_items/{mediaId} {
      // 학생도 미디어 목록/본문을 봐야 하므로 로그인 사용자 전체 읽기 허용
      allow read: if isSignedIn();

      // 작성/수정/삭제는 교사만
      allow create: if isTeacher()
                    && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isTeacher();

      // 교사 평가(미디어당 1건, docId='default')
      match /teacher_evaluation/{docId} {
        allow read: if isSignedIn();   // 학생 모델링 페이지가 읽어야 함
        allow write: if isTeacher();
      }

      // 학생 평가(미디어×학생별 1건, docId = 학생 uid)
      match /student_evaluations/{evalUid} {
        allow read, write: if isSelf(evalUid);
      }
    }

    // ====== groups/{groupId} : 모둠 협업 작업실 ======
    match /groups/{groupId} {
      // 공유 코드로 합류 전 조회 + 메타 표시를 위해 로그인 사용자 read 허용
      allow read: if isSignedIn();

      // 생성자가 곧 조장. leaderUid는 본인이어야 함
      allow create: if isSignedIn()
                    && request.resource.data.leaderUid == request.auth.uid;

      // 메타 갱신(활성 checklistId 포인터 등)은 멤버 허용, 단 leaderUid 불변
      allow update: if isGroupMember(groupId)
                    && request.resource.data.leaderUid == resource.data.leaderUid;

      // 모둠 삭제는 조장만
      allow delete: if isGroupLeader(groupId);

      // 멤버십: 본인만 합류/수정, 본인 탈퇴 또는 조장 강퇴
      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow create, update: if isSelf(memberUid);
        allow delete: if isSelf(memberUid) || isGroupLeader(groupId);
      }

      // 공유 작업실 데이터: 멤버만 read/write
      match /checklists/{checklistId} {
        allow read, write: if isGroupMember(groupId);
      }
      match /algorithm_model/{docId} {
        allow read, write: if isGroupMember(groupId);

        match /training_data/{dataId} {
          allow read, write: if isGroupMember(groupId);
        }
      }
      match /feedback_cards/{cardId} {
        allow read, write: if isGroupMember(groupId);
      }
      match /factcheck_history/{historyId} {
        allow read, write: if isGroupMember(groupId);
      }
      // single-flight 팩트체크 실행 조정 문서
      match /factcheck_runs/{runKey} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // 그 외 모든 경로 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
