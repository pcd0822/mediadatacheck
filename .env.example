# --- 클라이언트 (Vite는 VITE_ prefix만 클라이언트에 노출) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 교사 인증 코드는 더 이상 환경변수가 아닙니다.
# 첫 교사가 Google 로그인 후 화면에서 직접 설정하며, 값은 Firestore의
# config/teacher 문서에 salt+해시로 저장됩니다(이후 교사 추가 시 그 코드 필요).

# --- 서버리스 함수 전용 (절대 클라이언트 노출 금지) ---
GEMINI_API_KEY=
# 권장: gemini-2.5-flash (속도/비용 균형). 정확도 우선이면 gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash
